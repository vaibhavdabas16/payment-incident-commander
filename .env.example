# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Everything here is optional: with no .env at all the system runs end to end on the
# deterministic reasoner, and the evaluation harness produces identical numbers.

# --- Reasoning model -------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# When set, the Root Cause and Decision agents reason with Gemini. When absent, they fall
# back to the deterministic reasoner (ADR-003) and the system still works.
GEMINI_API_KEY=

# auto  - use Gemini when GEMINI_API_KEY is set, deterministic otherwise (default)
# gemini - require Gemini; fail loudly if the key is missing
# deterministic - never call a model. Benchmarks pin this for reproducibility.
PIC_LLM_PROVIDER=auto

# gemini-2.5-flash is the default: fast and cheap enough to sit inside an incident loop.
PIC_LLM_MODEL=gemini-2.5-flash

# --- Storage ---------------------------------------------------------------
# SQLite by default (ADR-004) so the repo runs with no database daemon.
# For Postgres: postgresql+psycopg://pic:pic@localhost:5432/pic
# PIC_DATABASE_URL=sqlite:///pic.db

# --- Misc ------------------------------------------------------------------
# PIC_VERBOSE=false
